{
  "name": "dsh-plugin-backlog-md",
  "version": "0.1.0",
  "description": "Native Backlog.md task management for DeepSeek Harness",
  "license": "MIT",
  "author": "Jeremy Tenjo",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "backlog.md",
    "backlog",
    "tasks",
    "markdown",
    "project-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremytenjo/dsh-plugin-backlog-md.git"
  },
  "homepage": "https://github.com/jeremytenjo/dsh-plugin-backlog-md#readme",
  "bugs": {
    "url": "https://github.com/jeremytenjo/dsh-plugin-backlog-md/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/server/*.js",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts test index.js",
    "format": "biome format --write src scripts test index.js",
    "test": "vitest run && node --test --test-concurrency=1 test/host/*.test.mjs",
    "test:integration": "BACKLOG_MD_INTEGRATION=1 node --test --test-concurrency=1 test/host/*.integration.test.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:client": "vitest run",
    "test:host": "node --test --test-concurrency=1 test/host/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@tanstack/react-query": "5.62.7",
    "@tanstack/react-table": "8.20.6",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "backlog.md": "1.55.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.25.10",
    "jsdom": "25.0.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "packageManager": "pnpm@10.25.0"
}
